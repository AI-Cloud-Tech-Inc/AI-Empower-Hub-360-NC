# ============================================================
# AI Empower Hub 360 - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ── App Settings ──────────────────────────────
APP_NAME="AI Empower Hub 360"
ENVIRONMENT=development
DEBUG=false
APP_PORT=8003

# ── AI / LLM API Keys ─────────────────────────
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── Server ────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8003

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password_here

# ── Database (uncomment when ready) ───────────
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ai_empower_hub
# DB_USER=postgres
# DB_PASSWORD=your_password_here
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_empower_hub

# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ── Security ──────────────────────────────────
SECRET_KEY=your_secret_key_here_min_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30